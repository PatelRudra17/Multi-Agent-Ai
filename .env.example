# ===========================================
#  Multi-Agent AI Website Builder
#  Environment Variables
# ===========================================

# AI Provider API Keys (at least one is required)
# You can also set these via the Settings page in the UI
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default AI model
# Options: claude-sonnet-4-6, claude-haiku-4-5, claude-opus-4-6, gpt-4o, gpt-4o-mini, gemini-2.0-flash, gemini-2.5-pro
DEFAULT_MODEL=claude-sonnet-4-6

# Server Configuration
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
OUTPUT_DIR=./output

# Stripe Payment Keys (optional - for future payment integration)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
